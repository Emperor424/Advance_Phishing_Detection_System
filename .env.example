# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ─── MySQL Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phishguard
DB_USER=root
DB_PASSWORD=your_mysql_password

# ─── Email (SMTP for sending activation / digest emails) ──────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=PhishGuard <your_gmail@gmail.com>

# ─── IMAP (for email ingestion polling) ───────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your_monitoring_inbox@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_POLL_INTERVAL_MINUTES=5

# ─── Google Safe Browsing API (optional — leave blank to skip) ────────────────
SAFE_BROWSING_API_KEY=

# ─── App Settings ─────────────────────────────────────────────────────────────
QUARANTINE_THRESHOLD=65
ACTIVATION_TOKEN_EXPIRY_HOURS=24
